# ==============================================================================
# CivicSense AI — Environment Configuration Template
# Copy to `.env` for local development. Never commit real secrets to version control.
# ==============================================================================

# --- AI Engine (Optional Secret) ---
# GEMINI_API_KEY: Server-side API key for @google/genai hybrid complaint enrichment.
# Leave empty to run deterministically with the built-in NLP & 6-factor rules engine.
GEMINI_API_KEY=""

# --- Server & Hosting Configuration ---
# APP_URL: Public base URL where this application is hosted (set automatically in AI Studio).
APP_URL="http://localhost:3000"

# NODE_ENV: Runtime mode ("development" or "production").
NODE_ENV="development"

# PORT: HTTP server port (3000 for unified dev/prod server, or 3001 for standalone API).
PORT="3000"

# --- Database Persistence ---
# DATABASE_PATH: SQLite database file path. Parent directories are created automatically.
DATABASE_PATH="./data/civicsense.db"

# --- Frontend API Configuration (Public Build-Time Variable) ---
# VITE_API_BASE_URL: Leave empty ("") for AI Studio, unified server, or Vite dev proxy.
# Only set to an origin (e.g., "http://localhost:3001") if hosting frontend and API on separate origins.
VITE_API_BASE_URL=""

# --- Authentication, RBAC & Session Policy ---
# ALLOWED_ADMIN_DOMAINS: Comma-separated official work domains permitted for Administrator login.
ALLOWED_ADMIN_DOMAINS="civicsense.gov.in,karnataka.gov.in"

# SESSION_TTL_HOURS: Session expiration window in hours (positive integer).
SESSION_TTL_HOURS="24"

# --- Seeded Account Provisioning (Server-Side Only — Never Hardcoded in Source) ---
# ADMIN_SEED_EMAIL: Official work email for the seeded Government Administrator (must match ALLOWED_ADMIN_DOMAINS).
ADMIN_SEED_EMAIL="meera.admin@civicsense.gov.in"

# ADMIN_SEED_PASSWORD: Secret password for the seeded Administrator (min 8 chars: upper, lower, number, symbol).
ADMIN_SEED_PASSWORD="CHANGE_ME_STRONG_ADMIN_PASSWORD"

# CITIZEN_DEMO_EMAIL: Email for the seeded demo Citizen account owning the 32 Karnataka demo complaints.
CITIZEN_DEMO_EMAIL="aarav.citizen@civicsense.demo"

# CITIZEN_DEMO_PASSWORD: Secret password for the seeded demo Citizen (min 8 chars: upper, lower, number, symbol).
CITIZEN_DEMO_PASSWORD="CHANGE_ME_STRONG_CITIZEN_PASSWORD"
